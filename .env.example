# ---------------------------------------------------------------------------
# Aroless — ortam değişkeni şablonu. `cp .env.example .env` yapıp doldurun.
# Vercel'de aynı anahtarları Project Settings → Environment Variables'a girin.
# ---------------------------------------------------------------------------

# 1) Supabase (ZORUNLU) ----------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=

# 2) AI Providers Tier 1-3 (çift anahtar desteği: _1 dolarsa 429/401/402'de _2) 
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=

GROQ_API_KEY_1=
GROQ_API_KEY_2=

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=

HF_TOKEN_1=
HF_TOKEN_2=

# 3) AWS (Bedrock Tier 4 — sadece Ürün Bulucu nihai sentezi — ve SES e-posta)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@aroless.tech

# 4) Lemon Squeezy abonelik / ödeme ----------------------------------------
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
# Lemon panelindeki Variant ID'yi girin; Product ID kullanmayın.
LEMON_SQUEEZY_VARIANT_ID=
# Birden fazla paket varsa genel ID yerine bunları kullanabilirsiniz.
# LEMON_SQUEEZY_STARTER_VARIANT_ID=
# LEMON_SQUEEZY_PRO_VARIANT_ID=
# LEMON_SQUEEZY_BUSINESS_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# 5) Uygulama --------------------------------------------------------------
APP_URL=https://aroless.tech
VITE_APP_URL=https://aroless.tech

# 6) Opsiyonel: e-posta yedeği (Resend) ------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Aroless <onboarding@resend.dev>"

# 7) Opsiyonel: bot koruması (Cloudflare Turnstile) ------------------------
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 8) Opsiyonel: OpenAI uyumlu AI ağ geçidi ---------------------------------
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODELS=
