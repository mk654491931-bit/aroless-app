# ---------------------------------------------------------------------------
# Aroless — ortam değişkeni şablonu. `cp .env.example .env` yapıp doldurun.
# Vercel'de aynı anahtarları Project Settings → Environment Variables'a girin.
# ---------------------------------------------------------------------------

# 1) Supabase (ZORUNLU) ----------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=

# 2) AI Providers — Multi-key havuz (failover & load balancing) ----------
# Gemini: 6 anahtar pool'u (round-robin fallback)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=

# Groq: 4 anahtar pool'u (fallback)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# Together AI: 1 anahtar (backup provider)
TOGETHER_API_KEY=

# Opsiyonel Tier 1 (hızlı işleme)
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=

# Opsiyonel fallback provider
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=

HF_TOKEN_1=
HF_TOKEN_2=

# 3) AWS (Bedrock Tier 4 — sadece Ürün Bulucu nihai sentezi — ve SES e-posta)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@aroless.tech

# 4) Paddle Billing v2 — abonelik / ödeme --------------------------------
# Paddle dashboard'ından API Keys bölümünde almak gerekir
PADDLE_API_KEY=
# Vendor ID (Paddle Dashboard > Settings > Developer)
PADDLE_VENDOR_ID=
# Public Key (Client-side SDK için)
PADDLE_PUBLIC_KEY=
# Client Token (checkout operations için)
PADDLE_CLIENT_TOKEN=
# Webhook Secret (webhook signature verification için)
PADDLE_WEBHOOK_SECRET=

# Ürün/Plan ID'leri (Paddle Dashboard > Products & Plans)
PADDLE_PRODUCT_ID=
# Birden fazla plan varsa:
# PADDLE_STARTER_PRODUCT_ID=
# PADDLE_PRO_PRODUCT_ID=
# PADDLE_BUSINESS_PRODUCT_ID=

# 5) Uygulama --------------------------------------------------------------
APP_URL=https://aroless.tech
VITE_APP_URL=https://aroless.tech

# 6) Opsiyonel: e-posta yedeği (Resend) ------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Aroless <onboarding@resend.dev>"

# 7) Opsiyonel: bot koruması (Cloudflare Turnstile) ------------------------
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 8) Opsiyonel: OpenAI uyumlu AI ağ geçidi ---------------------------------
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODELS=
