# ---------------------------------------------------------------------------
# Aroless — ortam değişkeni şablonu. `cp .env.example .env` yapıp doldurun.
# Sadece 1. blok zorunludur; diğerleri boş bırakılırsa ilgili özellik kapanır.
# Aynı liste lokal, preview ve canlı (Cloudflare/Node/Lovable) için geçerlidir.
# ---------------------------------------------------------------------------

# 1) Supabase (ZORUNLU) ----------------------------------------------------
# Tarayıcıya açılan değerler
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
# Sunucu tarafı (aynı değerler + service role anahtarı)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Kayıt akışı, admin paneli ve ücretsiz kredi denetimi bunu kullanır.
SUPABASE_SERVICE_ROLE_KEY=

# 2) AI sağlayıcıları (en az biri önerilir, otomatik rotasyon) --------------
# Gemini — numaralı havuz sırayla döner (rate limit'e takılmamak için).
GEMINI_1_API_KEY=
GEMINI_2_API_KEY=
GEMINI_3_API_KEY=
# Groq
GROQ_API_KEY=
GROQ_API_KEY_2=
# OpenRouter
OPENROUTER_API_KEY1=
OPENROUTER_API_KEY2=
# Hugging Face (görsel/metin yardımcı modüller)
HUGGING_FACE_API_KEY1=
HUGGING_FACE_API_KEY2=

# 3) Opsiyonel: OpenAI uyumlu AI ağ geçidi ---------------------------------
# Herhangi bir OpenAI uyumlu chat-completions uç noktası. Boşsa atlanır ve
# doğrudan yukarıdaki anahtar havuzları kullanılır.
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
# Virgülle ayrılmış model merdiveni, örn: openai/gpt-4o-mini,google/gemini-2.5-flash
AI_GATEWAY_MODELS=

# 4) Opsiyonel: e-posta (Resend) -------------------------------------------
# Boşsa OTP/bilgilendirme e-postaları sessizce atlanır.
RESEND_API_KEY=
RESEND_API_KEY_2=
RESEND_API_KEY_3=
RESEND_FROM_EMAIL="Aroless <onboarding@resend.dev>"

# 5) Opsiyonel: bot koruması (Cloudflare Turnstile) ------------------------
# Boşsa captcha devre dışı kalır, kayıt akışı yine çalışır.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
