# ---------------------------------------------------------------------------
# Velora — environment template. Copy to `.env` and fill in.
# Only the Supabase block is required; everything else degrades gracefully.
# ---------------------------------------------------------------------------

# 1) Supabase (REQUIRED) --------------------------------------------------
# Browser-visible
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
# Server-side (same values + service role)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=

# 2) AI providers (all optional, rotated automatically) -------------------
# Gemini keys — add as many as you like, numbered pools are rotated.
GEMINI_1_API_KEY=
GEMINI_2_API_KEY=
GEMINI_3_API_KEY=
# Groq
GROQ_API_KEY=
GROQ_API_KEY_2=
# OpenRouter
OPENROUTER_API_KEY1=
OPENROUTER_API_KEY2=
# Hugging Face
HUGGING_FACE_API_KEY1=
HUGGING_FACE_API_KEY2=

# 3) Optional OpenAI-compatible AI gateway --------------------------------
# Any OpenAI-compatible chat-completions endpoint. Leave empty to disable.
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
# Comma separated model ladder, e.g. openai/gpt-4o-mini,google/gemini-2.5-flash
AI_GATEWAY_MODELS=

# 4) Optional extras -------------------------------------------------------
# Transactional e-mail (Resend). Empty = e-mails silently skipped.
RESEND_API_KEY=
# Cloudflare Turnstile bot protection. Empty = captcha disabled.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
